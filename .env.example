# ==============================================================================
# HOTEL RESERVATION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your Supabase credentials:
#   cp .env.example .env
#
# Obtain your credentials from your Supabase Dashboard:
#   https://supabase.com/dashboard -> Select Project -> Settings -> API
# ==============================================================================

# Supabase Project URL (e.g. https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Project Settings -> API -> Project API keys -> anon / public)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Secret Key (Project Settings -> API -> Project API keys -> service_role / secret)
# Required for server-side trusted DB queries, admin RBAC operations, and PostgREST sync
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase JWT Secret (Project Settings -> API -> JWT Settings -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Java Backend Port
PORT=8080

# Logging Configuration
# Levels: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# File Logger Output Destination
LOG_FILE=logs/hotel-server.log

# Enable Supabase PostgreSQL Data Sync (true / false)
ENABLE_DB_SYNC=true
