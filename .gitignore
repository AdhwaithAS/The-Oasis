# ==============================================================================
# Git Ignore Configuration for Wanderlust Hotel Management Platform
# Covers: Java Backend, Next.js / React Frontend, Supabase, Node, and IDEs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Keys (CRITICAL - Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env*.local
.env.production
.env.staging
.env.development
*.env
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local
*.pem
*.key
*.cert
*.pfx
secrets/
.agents
# ------------------------------------------------------------------------------
# 2. Java Backend & Compilation Artifacts
# ------------------------------------------------------------------------------
bin/
backend/bin/
*.class
*.jar
*.war
*.ear
*.nar
build/
target/
.gradle/
*.iml
*.ipr
*.iws

# Java Crash & Profiler logs
hs_err_pid*
replay_pid*
.attach_pid*

# ------------------------------------------------------------------------------
# 3. Application Logs & Runtime Files
# ------------------------------------------------------------------------------
logs/
backend/logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Next.js / React Frontend Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/
frontend/dist/

# Next.js Cache & Turbopack
.turbo/
frontend/.turbo/
.cache/

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 5. Operating System Junk
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 6. IDEs & Code Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA / WebStorm / Android Studio
.idea/
*.iws
out/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans

# Sublime Text & Vim
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# 7. Testing & Coverage
# ------------------------------------------------------------------------------
coverage/
frontend/coverage/
.nyc_output/
*.lcov
.clinic

# ------------------------------------------------------------------------------
# 8. Temporary & Scratch Files
# ------------------------------------------------------------------------------
tmp/
temp/
scratch/
*.tmp
